PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_task_manager
JWT_SECRET=smart_task_manager_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# AI Layer Configuration (Supports 'gemini', 'openai', or built-in intelligent 'heuristic' parser)
# If no API key is provided, the system seamlessly uses intelligent NLP + chrono-node extraction!
AI_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=

# Central Gmail API Integration (Google Cloud OAuth2)
# If not configured, the system uses the full-featured Interactive Gmail Simulator
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/oauth2callback
GMAIL_REFRESH_TOKEN=
CENTRAL_GMAIL_USER=tasks@smarttaskmanager.com

# Email Notifications (Gmail SMTP / Ethereal test SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Smart Task Manager" <notifications@smarttaskmanager.com>

